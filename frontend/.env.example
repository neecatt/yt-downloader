# Required to protect the dashboard. Never expose this as NEXT_PUBLIC_*.
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Server-only connection to the bot's future activity API.
ADMIN_API_URL=https://your-bot-api.example.com
ADMIN_ACTIVITY_PATH=/admin/activity
ADMIN_API_TOKEN=replace-with-a-separate-api-token

# Optional: show clearly-labelled local demo data when no API is connected.
DASHBOARD_DEMO=false
