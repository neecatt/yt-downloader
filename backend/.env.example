# Copy this file to .env for local development, or add these variables in
# Railway Variables. Replace every placeholder before deploying.

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_MAX_UPLOAD_MB=49
# Optional custom Bot API endpoints
TELEGRAM_API_BASE_URL=
TELEGRAM_API_FILE_BASE_URL=

# Downloading
MAX_DOWNLOAD_MB=2048
MAX_URL_LENGTH=4096
DOWNLOAD_WORKERS=2
FRAGMENT_WORKERS=4
HTTP_CHUNK_SIZE_MB=10
DELIVERY_MODE=auto
ALLOW_GENERIC_HTTPS=false

# Optional yt-dlp access settings
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=
YTDLP_PROXY=
YTDLP_PLAYER_CLIENT=
YTDLP_PO_TOKEN=
YTDLP_POT_PROVIDER_URL=
YTDLP_JS_RUNTIME=node

# PostgreSQL activity database
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Cloudflare R2 / S3-compatible storage
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Alternative format supported by the application: access-key:secret-key
R2_API_TOKEN=
R2_BUCKET_NAME=replace-with-r2-bucket-name
R2_PUBLIC_BASE_URL=
R2_PRESIGNED_URL_TTL_SECONDS=86400
R2_CLEANUP_INTERVAL_SECONDS=60
R2_UPLOAD_CONCURRENCY=8

# Admin API
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
ADMIN_API_ENABLED=true
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8080
ADMIN_REQUESTS_PER_MINUTE=60

# Donation prompts
DONATION_URL=https://www.buymeacoffee.com/your-name
DONATION_PROMPTS_ENABLED=true
DONATION_PROMPT_COOLDOWN_HOURS=24

# Celery / Redis transcription queue
REDIS_URL=redis://username:password@hostname:6379/0
TRANSCRIPTION_QUEUE_ENABLED=true
TRANSCRIPTION_QUEUE_MAX_SIZE=100
TRANSCRIPTION_QUEUE_MAX_PER_USER=3
TRANSCRIPTION_MAX_RETRIES=2
TRANSCRIPTION_STALE_JOB_SECONDS=21600
CELERY_VISIBILITY_TIMEOUT_SECONDS=21600
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_TASK_TIME_LIMIT_SECONDS=18000
CELERY_SOFT_TIME_LIMIT_SECONDS=17400

# Modal transcription
TRANSCRIPTION_ENABLED=true
MODAL_TOKEN_ID=replace-with-modal-token-id
MODAL_TOKEN_SECRET=replace-with-modal-token-secret
MODAL_APP_NAME=yt-downloader-transcriber
MODAL_FUNCTION_NAME=transcribe

# Optional logging
LOG_LEVEL=INFO

# Modal deployment-only variables. Configure these in Modal secrets or when
# deploying modal_transcriber.py, not necessarily in the Railway bot service.
# WHISPER_MODEL=small
# WHISPER_MODEL_VOLUME=yt-downloader-whisper-models
# WHISPER_GPU=T4
# MODAL_MIN_CONTAINERS=0
# MODAL_MAX_CONTAINERS=1
# MODAL_SCALEDOWN_WINDOW_SECONDS=300
# TRANSCRIPTION_MAX_DURATION_SECONDS=14400
# TRANSCRIPTION_MAX_AUDIO_MB=2048
